<script>(function(){
var d=document;
function byId(i){return d.getElementById(i)}
function url(){var f=byId('share-url');return (f&&f.value)||''}
var fb=byId('feedback');
var fbT=0;
function say(m){if(!fb)return;fb.textContent=m;if(fbT)clearTimeout(fbT);fbT=setTimeout(function(){fb.textContent=''},2200)}
function swap(b){var o=b.getAttribute('data-label')||b.textContent;b.setAttribute('data-label',o);b.textContent='\u2713 Copied!';if(b._t)clearTimeout(b._t);b._t=setTimeout(function(){b.textContent=o;b._t=0},2200)}
function copy(b){try{navigator.clipboard.writeText(url()).then(function(){swap(b);say("Link copied \u2014 go make someone's day \u2726")},function(){say('Copy didn\u2019t work \u2014 select the link above and copy it.')})}catch(e){say('Copy didn\u2019t work \u2014 select the link above and copy it.')}}
var canCopy=!!(navigator.clipboard&&navigator.clipboard.writeText);
var canShare=!!navigator.share;
var cps=d.querySelectorAll('[data-copy]');
for(var i=0;i<cps.length;i++){(function(b){if(!canCopy)return;b.hidden=false;b.addEventListener('click',function(){copy(b)})})(cps[i])}
var sh=byId('share-btn');
function shareFail(e){if(e&&e.name==='AbortError')return;if(canCopy){copy(sh);return}say('Sharing didn\u2019t open \u2014 select the link above and copy it.')}
if(sh&&(canShare||canCopy)){sh.hidden=false;sh.addEventListener('click',function(){
if(canShare){var r;try{r=navigator.share({url:url()})}catch(e){shareFail(e);return}
if(r&&r.then){r.then(null,shareFail)}
return}
copy(sh)})}
var bf=byId('builder');
var toBs=d.querySelectorAll('[data-to-builder]');
if(bf){for(var b=0;b<toBs.length;b++){toBs[b].addEventListener('click',function(){
// The anchor already scrolls; this also moves keyboard focus into the frame so
// the first question is where the caret lands. It opens nothing and sends
// nothing.
try{bf.focus()}catch(e){}})}}
if(bf){
var SITE='https://getamplify.team';
var greeted=false,tries=0,timer=0;
function hello(){try{bf.contentWindow.postMessage({type:'amplify-embed-hello'},SITE)}catch(e){}}
function greet(){if(greeted||tries>39)return;tries++;hello();timer=setTimeout(greet,250)}
function startGreeting(){if(greeted)return;if(timer)clearTimeout(timer);tries=0;greet()}
bf.addEventListener('load',startGreeting);
window.addEventListener('message',function(e){
if(e.origin!==SITE||e.source!==bf.contentWindow)return;
var m=e.data;if(!m||typeof m!=='object'||m.type!=='amplify-embed-height')return;
var h=m.height;if(typeof h!=='number'||!isFinite(h))return;
greeted=true;if(timer){clearTimeout(timer);timer=0}
h=Math.max(320,Math.min(12000,Math.ceil(h)));
bf.style.height=h+'px'});
startGreeting();
}
var med=byId('media'),po=byId('playover'),du=byId('dur'),dim=byId('dim'),dimSep=byId('dim-sep');
function mmss(t){var s=Math.floor(t%60),m=Math.floor(t/60)%60,h=Math.floor(t/3600);var p=(s<10?'0':'')+s;return h?h+':'+(m<10?'0':'')+m+':'+p:m+':'+p}
function showDim(w,h){if(!dim||!w||!h)return;dim.textContent=w+' \u00d7 '+h;dim.hidden=false;if(dimSep)dimSep.hidden=false}
if(med&&med.tagName==='IMG'){
function imgDim(){showDim(med.naturalWidth,med.naturalHeight)}
if(med.complete)imgDim();else med.addEventListener('load',imgDim);
}else if(med){var vid=med;
vid.addEventListener('loadedmetadata',function(){
showDim(vid.videoWidth,vid.videoHeight);
if(du&&isFinite(vid.duration)&&vid.duration>0){du.textContent=mmss(vid.duration)+' \u00b7 Video';du.hidden=false}
if(po&&vid.paused)po.hidden=false});
if(po){po.addEventListener('click',function(){po.hidden=true;try{vid.play()}catch(e){}});
vid.addEventListener('play',function(){po.hidden=true})}
}
})();</script>
